# Salin ke .env bila perlu mengubah nilai; tanpa .env, default docker-compose.yml dipakai.
# DATABASE_URL: dipakai api & etl di dalam jaringan Compose (host "db").
DATABASE_URL=postgresql://taman:taman@db:5432/taman
# NEXT_PUBLIC_API_URL: dipanggil dari browser, jadi alamat yang terlihat dari host.
NEXT_PUBLIC_API_URL=http://localhost:8000
