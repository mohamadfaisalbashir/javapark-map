# Salin ke .env bila perlu mengubah nilai; tanpa .env, default docker-compose.yml dipakai.
# DATABASE_URL: dipakai api & etl di dalam jaringan Compose (host "db").
DATABASE_URL=postgresql://taman:taman@db:5432/taman
# NEXT_PUBLIC_API_URL: dipanggil dari browser, jadi alamat yang terlihat dari host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Panorama 360° (requirements 6.5, FR-06). Kosong = fitur terkait dimatikan. ----------
# >>> API KEY: Google, hanya untuk etl/cek_pano.py. Batasi ke "Street View Static API".
GOOGLE_MAPS_SERVER_KEY=
# >>> API KEY: token klien Mapillary (mapillary.com/dashboard/developers), hanya untuk etl/cek_pano.py.
MAPILLARY_TOKEN=
# >>> API KEY: Google untuk viewer di browser (terlihat publik!). Batasi ke "Maps Embed API" dan
# HTTP referrer, mis. http://localhost:3000/* dan *.trycloudflare.com/*. Setelah diubah:
#   docker compose up -d --build web
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
